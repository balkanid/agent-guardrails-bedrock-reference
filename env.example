# Copy to .env and fill. Never commit .env.

BALKANID_PUBLIC_API_URL=https://your-tenant.balkanid.app/api/public
API_KEY_ID=
API_KEY_SECRET=
# Human accountable for the agent (must exist in your tenant)
BALKANID_AGENT_OWNER_EMAIL=
# BalkanID integration id for the AWS account
INTEGRATION_ID=

AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# --- The agent ---
AGENT_NAME=dev-assistant
AGENT_PURPOSE="Summarizes application logs for the on-call developer"
# Hours until the agent is torn down (policies/guardrails.json caps this)
AGENT_TTL_HOURS=8
# Names reviewed on the BalkanID requests (no admin or *FullAccess policies)
AGENT_POLICY_NAMES=
# Matching ARNs attached by Terraform, comma separated
AGENT_POLICY_ARNS=
# Subagent only: the parent agent (child shares the parent's permissions boundary)
PARENT_AGENT=
FOUNDATION_MODEL=amazon.nova-micro-v1:0

# Leave empty. Setting it to reuse a developer or other existing role is refused by policy_check.py.
EXISTING_EXECUTION_ROLE_ARN=

# Approval polling
POLL_SECONDS=5
POLL_TIMEOUT_SECONDS=900

# --- Advanced (defaults shown) ---
# AGENT_EXPIRES_AT=                    # set by lifecycle.sh from policy_check.py; do not set by hand
# SERVICE_ACCOUNT_AWS_SERVICE_NAMES=bedrock-agentcore.amazonaws.com
# TRIGGER_INTEGRATION_SYNC=true
# GQL_MAX_RETRIES=5
# GQL_RETRY_BACKOFF_SECONDS=2
# GQL_TIMEOUT_SECONDS=120
# BALKANID_DEVELOPER_ID=               # recorded as requested_by when not running in GitHub Actions
# AWS_CLI=                             # path to aws if not on PATH
# BALKANID_SKIP_DOTENV=false           # tests and CI: ignore .env
